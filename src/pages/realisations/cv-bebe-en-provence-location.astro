---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projet = {
  client:      "C&V Bébé en Provence",
  activite:    "Location de matériel bébé",
  ville:       "Sénas (13)",
  url:         "https://cvbebeenprovence.fr",
  urlLabel:    "cvbebeenprovence.fr",
  prestations: ["Site e-commerce", "Réservation en ligne", "Paiement Stripe", "Identité visuelle"],
  delai:       "Clé en main",
  annee:       "2025",
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": "Site web, C&V Bébé en Provence, location de matériel bébé",
  "creator": { "@type": "Organization", "name": "Aurore", "url": "https://agence-aurore.fr" },
  "description": "Création d'un site de réservation en ligne avec paiement sécurisé pour C&V Bébé en Provence, service de location de matériel bébé basé à Sénas (13).",
  "url": "https://cvbebeenprovence.fr",
  "locationCreated": { "@type": "Place", "name": "Sénas, Bouches-du-Rhône, France" },
  "dateCreated": "2025",
  "keywords": "site location matériel bébé, réservation en ligne, paiement Stripe, identité visuelle"
};
---

<BaseLayout
  title="Réalisation, Site C&V Bébé en Provence, location de matériel bébé | aurore"
  description="Comment aurore a créé le site de réservation en ligne de C&V Bébé en Provence (Sénas) : catalogue, réservation avec dates, paiement Stripe et identité visuelle. Lancement clé en main."
  slug="realisations/cv-bebe-en-provence-location"
  schema={schema}
>


  <!-- ─── HERO ─── -->
  <section class="fiche-hero">
    <div class="container">
      <div class="fiche-hero-inner">
        <div class="fiche-hero-content">
          <div class="tags" style="margin-bottom: 20px;">
            {projet.prestations.map(p => (
              <span class="badge badge-aurora">{p}</span>
            ))}
          </div>
          <h1 class="fiche-h1">
            C&amp;V Bébé<br />
            <span class="hero-serif">en Provence.</span>
          </h1>
          <p class="fiche-sub">
            Un site de réservation en ligne avec paiement sécurisé pour une jeune entreprise
            de location de matériel bébé. Livré clé en main, prêt à encaisser dès l'ouverture.
          </p>

          <!-- Tableau client -->
          <table class="client-table" aria-label="Informations du projet">
            <tbody>
              <tr>
                <th scope="row">Client</th>
                <td>{projet.client}</td>
              </tr>
              <tr>
                <th scope="row">Activité</th>
                <td>{projet.activite}</td>
              </tr>
              <tr>
                <th scope="row">Ville</th>
                <td>{projet.ville}</td>
              </tr>
              <tr>
                <th scope="row">Site livré</th>
                <td>
                  <a
                    href={projet.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="table-link"
                  >
                    {projet.urlLabel} ↗
                  </a>
                </td>
              </tr>
              <tr>
                <th scope="row">Prestations</th>
                <td>{projet.prestations.join(", ")}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Capture du site -->
        <div class="fiche-hero-capture">
          <img src="/cvbebe-portrait.webp" alt="Site de réservation de C&V Bébé en Provence, location de matériel bébé" style="max-width:320px; margin:0 auto; display:block; border-radius:var(--radius-md); object-fit:cover; object-position:center top; aspect-ratio:3/4;" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 1 : CONTEXTE ─── -->
  <section class="section fiche-section">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">01, Contexte</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Lancer une activité avec un vrai outil de vente.</h2>
        <div class="fiche-text fade-in">
          <p>C&amp;V Bébé en Provence est un service de location et livraison de matériel bébé haut de gamme (poussettes, lits, sièges auto, marques premium), basé à Sénas et rayonnant sur tout le Pays d'Aix, Salon, Avignon et le Luberon.</p>
          <p>Le besoin n'était pas une simple vitrine : il fallait un site capable de <strong>gérer les réservations avec dates, de calculer les tarifs et d'encaisser en ligne</strong> dès le lancement de l'entreprise, sans friction pour les jeunes parents.</p>
          <p>L'enjeu : donner à une activité qui démarre la même crédibilité et la même fluidité qu'un acteur installé.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 2 : SOLUTION ─── -->
  <section class="section fiche-section" style="background: var(--gray-50);">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">02, Solution</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Un site de réservation complet, clé en main.</h2>
        <div class="fiche-text fade-in">
          <p>Un vrai outil de vente en ligne, pensé pour être rassurant et simple d'usage, et pour fonctionner sans abonnement mensuel.</p>
        </div>
        <div class="solution-grid fade-in" style="margin-top: 32px;">
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            </div>
            <div>
              <h3>Catalogue produits &amp; packs</h3>
              <p>Équipements à l'unité et packs composables, avec pages dédiées, descriptions et visuels clairs.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            </div>
            <div>
              <h3>Réservation en ligne</h3>
              <p>Choix des dates, de l'adresse de livraison et calcul automatique du tarif avec dégressif longue durée.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            </div>
            <div>
              <h3>Paiement sécurisé Stripe</h3>
              <p>Encaissement en ligne fiable et sécurisé, intégré directement au parcours de réservation.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <div>
              <h3>Identité visuelle</h3>
              <p>Une direction douce et rassurante, à l'image d'une marque de confiance pour jeunes parents.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 3 : RÉSULTAT ─── -->
  <section class="section fiche-section">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">03, Résultat</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Opérationnel dès l'ouverture.</h2>
        <div class="fiche-text fade-in">
          <p>Le site a accompagné le lancement de l'entreprise : catalogue en ligne, réservation et paiement fonctionnels dès le premier jour. Un démarrage fluide, sans dépendre d'une plateforme tierce ni d'un abonnement mensuel.</p>
        </div>

        <div class="resultat-screens fade-in" style="margin-top: 32px;">
          <img src="/cvbebe-1.webp" alt="Site de réservation C&V Bébé en Provence, location de matériel bébé" style="width:100%; border-radius:var(--radius-md); object-fit:contain; background:var(--gray-50, #f9f9f9);" loading="lazy" />
        </div>

        <div class="metrics-row fade-in" style="margin-top:32px;">
          <div class="metric-card">
            <div class="metric-card-value">24/7</div>
            <div class="metric-card-label">Réservation en ligne</div>
          </div>
          <div class="metric-card">
            <div class="metric-card-value">Stripe</div>
            <div class="metric-card-label">Paiement sécurisé</div>
          </div>
          <div class="metric-card">
            <div class="metric-card-value">−25 %</div>
            <div class="metric-card-label">Tarif dégressif longue durée</div>
          </div>
          <div class="metric-card">
            <div class="metric-card-value">0 €</div>
            <div class="metric-card-label">Hébergement mensuel</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 4 : TÉMOIGNAGE ─── -->
  <section class="section fiche-section" style="background: var(--gray-50);">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">04, Témoignage</span>
      </div>
      <div class="fiche-section-content">
        <div class="temoignage-block fade-in">
          <div class="temoignage-quote-mark" aria-hidden="true">"</div>
          <blockquote class="temoignage-texte">
            Élodie est tombée à pic dans le lancement de ma société de location de matériel bébé : c'est la clé de ce beau démarrage. Elle a créé le site en très peu de temps, à mon image, avec seulement quelques informations. Très réactive, à l'écoute, elle sait ce qu'elle fait. On continue ensemble pour l'agrandissement du site 🌻
          </blockquote>
          <div class="temoignage-auteur">
            <div class="temoignage-avatar" style="background: #7C9A86;" aria-hidden="true">
              <span>CV</span>
            </div>
            <div>
              <div class="temoignage-nom">Maeva</div>
              <div class="temoignage-role">C&amp;V Bébé en Provence · Location de matériel bébé</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 5 : CTA PROJET SIMILAIRE ─── -->
  <section class="section fiche-section">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">05, Et vous ?</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Besoin de vendre ou réserver en ligne ?</h2>
        <div class="fiche-text fade-in">
          <p>Vous lancez une activité qui a besoin d'un vrai outil de réservation ou de vente en ligne, avec paiement sécurisé et sans abonnement mensuel ? C'est exactement ce que propose le pack avec réservation d'aurore.</p>
          <p>Basée à Aix-en-Provence, j'interviens dans toute la France. Un formulaire de 2 minutes suffit pour recevoir un devis détaillé sous 48h.</p>
        </div>
        <div class="fiche-cta-buttons fade-in">
          <a href="/contact/" class="btn btn-aurora btn-lg">Démarrer mon projet →</a>
          <a href="/tarifs/" class="btn btn-outline btn-lg">Voir les tarifs</a>
          <a href="/realisations/" class="btn btn-ghost btn-lg">Voir toutes les réalisations</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── NAVIGATION ENTRE FICHES ─── -->
  <nav class="fiche-nav" aria-label="Navigation entre les réalisations">
    <div class="container">
      <div class="fiche-nav-inner">
        <a href="/realisations/blackwood-deck-terrasse-bois-aix/" class="fiche-nav-prev-link">
          <span class="fiche-nav-label">Réalisation précédente</span>
          <span class="fiche-nav-titre">← Blackwood Deck, Terrasses bois</span>
        </a>
        <a href="/realisations/le-mazarin-logiciel-conciergerie/" class="fiche-nav-prev-link fiche-nav-next">
          <span class="fiche-nav-label">Réalisation suivante</span>
          <span class="fiche-nav-titre">Le Mazarin, Logiciel métier →</span>
        </a>
      </div>
    </div>
  </nav>

</BaseLayout>

<style>
  /* ─── HERO FICHE ─── */
  .fiche-hero {
    padding: 32px 0 80px;
  }

  .fiche-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .fiche-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1.05;
    color: var(--black);
    margin-bottom: 16px;
  }

  .fiche-sub {
    font-size: clamp(15px, 1.2vw, 17px);
    color: var(--gray-500);
    line-height: 1.65;
    margin-bottom: 32px;
  }

  /* Couverture fond uni */
  .fiche-cover {
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 32px;
    text-align: center;
    border: 1.5px solid rgba(0,0,0,0.06);
  }

  .fiche-cover-name {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.05;
  }

  .fiche-cover-sub {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Tableau client */
  .client-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .client-table tr {
    border-bottom: 1px solid var(--gray-100);
  }

  .client-table tr:last-child {
    border-bottom: none;
  }

  .client-table th {
    text-align: left;
    font-weight: 600;
    color: var(--black);
    padding: 10px 16px 10px 0;
    width: 130px;
    vertical-align: top;
  }

  .client-table td {
    color: var(--gray-500);
    padding: 10px 0;
    vertical-align: top;
  }

  .table-link {
    color: var(--aurora);
    font-weight: 500;
    transition: var(--transition);
  }

  .table-link:hover {
    color: var(--aurora-dark);
  }

  /* ─── LAYOUT SECTIONS ─── */
  .fiche-section { padding: 80px 0; }

  .fiche-container {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 64px;
    align-items: start;
  }

  .fiche-section-label { padding-top: 6px; }

  .fiche-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fiche-text p {
    font-size: 16px;
    color: var(--gray-500);
    line-height: 1.75;
    margin: 0;
  }

  /* ─── SOLUTION GRID ─── */
  .solution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .solution-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .solution-icon {
    width: 40px;
    height: 40px;
    background: var(--aurora-pale);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--aurora);
    flex-shrink: 0;
  }

  .solution-item h3 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }

  .solution-item p {
    font-size: 14px;
    color: var(--gray-500);
    line-height: 1.6;
    margin: 0;
  }

  /* ─── RÉSULTAT ─── */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .metric-card {
    background: var(--white);
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-md);
    padding: 20px 16px;
    text-align: center;
  }

  .metric-card-value {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--black);
    line-height: 1;
    margin-bottom: 6px;
  }

  .metric-card-label {
    font-size: 12px;
    color: var(--gray-500);
    line-height: 1.4;
  }

  /* ─── TÉMOIGNAGE ─── */
  .temoignage-block {
    background: var(--aurora-pale);
    border: 1.5px solid rgba(255,107,26,0.15);
    border-radius: var(--radius-xl);
    padding: 48px;
    position: relative;
  }

  .temoignage-quote-mark {
    font-family: var(--font-serif);
    font-size: 96px;
    line-height: 0.8;
    color: var(--aurora-light);
    margin-bottom: 16px;
    font-style: italic;
  }

  .temoignage-texte {
    font-size: clamp(17px, 1.5vw, 20px);
    font-style: italic;
    color: var(--gray-700);
    line-height: 1.7;
    margin-bottom: 32px;
    font-family: var(--font-serif);
    border: none;
    padding: 0;
  }

  .temoignage-auteur {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .temoignage-avatar {
    width: 44px;
    height: 44px;
    background: var(--aurora-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--white);
    flex-shrink: 0;
  }

  .temoignage-nom {
    font-size: 15px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.01em;
  }

  .temoignage-role {
    font-size: 13px;
    color: var(--gray-500);
    margin-top: 2px;
  }

  /* ─── CTA BOUTONS FICHE ─── */
  .fiche-cta-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  /* ─── NAVIGATION FICHES ─── */
  .fiche-nav {
    border-top: 1px solid var(--gray-100);
    padding: 32px 0;
  }

  .fiche-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .fiche-nav-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gray-500);
    margin-bottom: 4px;
  }

  .fiche-nav-next {
    text-align: right;
  }

  .fiche-nav-prev-link {
    display: block;
  }

  .fiche-nav-titre {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.02em;
    transition: var(--transition);
  }

  .fiche-nav-prev-link:hover .fiche-nav-titre {
    color: var(--aurora);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .fiche-hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .fiche-container {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .fiche-section-label { padding-top: 0; }
  }

  @media (max-width: 768px) {
    .fiche-hero { padding: 16px 0 56px; }

    .solution-grid { grid-template-columns: 1fr; }

    .metrics-row { grid-template-columns: 1fr 1fr; }

    .temoignage-block { padding: 28px 24px; }

    .fiche-cta-buttons { flex-direction: column; }

    .fiche-cta-buttons .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
