---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projet = {
  client:      "Blackwood Deck",
  activite:    "Terrasses en bois sur mesure",
  ville:       "Aix-en-Provence (13)",
  url:         "https://blackwooddeck.com",
  urlLabel:    "blackwooddeck.com",
  prestations: ["Refonte complète", "Site vitrine", "SEO local", "Identité visuelle", "Fiche Google"],
  delai:       "Clé en main",
  annee:       "2025",
};

const schema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": "Site web, Blackwood Deck, terrasses en bois à Aix-en-Provence",
  "creator": { "@type": "Organization", "name": "Aurore", "url": "https://agence-aurore.fr" },
  "description": "Refonte complète du site de Blackwood Deck, artisan spécialiste des terrasses en bois sur mesure à Aix-en-Provence : site vitrine, SEO local et identité visuelle.",
  "url": "https://blackwooddeck.com",
  "locationCreated": { "@type": "Place", "name": "Aix-en-Provence, Bouches-du-Rhône, France" },
  "dateCreated": "2025",
  "keywords": "site terrasse bois, artisan terrasse Aix-en-Provence, SEO local artisan"
};
---

<BaseLayout
  title="Réalisation, Site Blackwood Deck, terrasses en bois à Aix-en-Provence | aurore"
  description="Comment aurore a refondu le site de Blackwood Deck, artisan de terrasses en bois à Aix-en-Provence : site vitrine, SEO local et identité visuelle. 5 demandes de devis dont 3 signées dès la mise en ligne."
  slug="realisations/blackwood-deck-terrasse-bois-aix"
  schema={schema}
>


  <!-- ─── HERO ─── -->
  <section class="fiche-hero">
    <div class="container">
      <div class="fiche-hero-inner">
        <div class="fiche-hero-content">
          <div class="tags" style="margin-bottom: 20px;">
            {projet.prestations.map(p => (
              <span class="badge badge-aurora">{p}</span>
            ))}
          </div>
          <h1 class="fiche-h1">
            Blackwood Deck<br />
            <span class="hero-serif">Terrasses bois.</span>
          </h1>
          <p class="fiche-sub">
            Refonte complète du site d'un artisan haut de gamme spécialiste de la terrasse
            en bois sur mesure à Aix-en-Provence. Site vitrine, SEO local et identité visuelle.
          </p>

          <!-- Tableau client -->
          <table class="client-table" aria-label="Informations du projet">
            <tbody>
              <tr>
                <th scope="row">Client</th>
                <td>{projet.client}</td>
              </tr>
              <tr>
                <th scope="row">Activité</th>
                <td>{projet.activite}</td>
              </tr>
              <tr>
                <th scope="row">Ville</th>
                <td>{projet.ville}</td>
              </tr>
              <tr>
                <th scope="row">Site livré</th>
                <td>
                  <a
                    href={projet.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="table-link"
                  >
                    {projet.urlLabel} ↗
                  </a>
                </td>
              </tr>
              <tr>
                <th scope="row">Prestations</th>
                <td>{projet.prestations.join(", ")}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Capture du site -->
        <div class="fiche-hero-capture">
          <img src="/blackwood-portrait.webp" alt="Site web de Blackwood Deck, terrasses en bois à Aix-en-Provence" style="max-width:320px; margin:0 auto; display:block; border-radius:var(--radius-md); object-fit:cover; object-position:center top; aspect-ratio:3/4;" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 1 : CONTEXTE ─── -->
  <section class="section fiche-section">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">01, Contexte</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Un savoir-faire premium, un site qui ne suivait pas.</h2>
        <div class="fiche-text fade-in">
          <p>Blackwood Deck conçoit et pose des terrasses en bois noble sur mesure dans le Pays d'Aix : bois certifié, garantie décennale, et vingt ans de savoir-faire artisanal.</p>
          <p>Le problème : un site réalisé en interne sur un outil grand public (Webador) qui <strong>ne reflétait pas le positionnement haut de gamme</strong> de l'activité et générait peu de demandes qualifiées. L'image en ligne était en décalage avec la qualité du travail réel.</p>
          <p>L'objectif : une <strong>refonte complète</strong> à la hauteur du savoir-faire, pensée pour inspirer confiance et transformer les visiteurs en demandes de devis concrètes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 2 : SOLUTION ─── -->
  <section class="section fiche-section" style="background: var(--gray-50);">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">02, Solution</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Une refonte clé en main, orientée conversion.</h2>
        <div class="fiche-text fade-in">
          <p>Site reconstruit intégralement en code pur, rapide et pensé pour le référencement local. Chaque page met en valeur la matière, le savoir-faire et les réalisations.</p>
        </div>
        <div class="solution-grid fade-in" style="margin-top: 32px;">
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            </div>
            <div>
              <h3>Site vitrine complet</h3>
              <p>Pages savoir-faire, essences de bois, réalisations et guides pratiques. Navigation claire et copywriting orienté demande de devis.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-6-6m6 6v-4.8m0 4.8h-4.8"/><path d="M3 16.2V21m0 0h4.8M3 21l6-6"/><path d="M21 7.8V3m0 0h-4.8M21 3l-6 6"/><path d="M3 7.8V3m0 0h4.8M3 3l6 6"/></svg>
            </div>
            <div>
              <h3>SEO local</h3>
              <p>Optimisation sur « terrasse bois Aix-en-Provence » et les communes du Pays d'Aix. Pages zones d'intervention et contenu pensé pour Google.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <div>
              <h3>Identité visuelle</h3>
              <p>Palette bois naturel, noir et blanc, typographies soignées : une direction visuelle qui exprime l'exigence artisanale, du premier coup d'œil.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h3"/></svg>
            </div>
            <div>
              <h3>Formulaire de devis</h3>
              <p>Demande de devis gratuite avec notification instantanée, pour capter chaque contact qualifié directement depuis le site.</p>
            </div>
          </div>
          <div class="solution-item">
            <div class="solution-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h3>Fiche Google Business</h3>
              <p>Création et optimisation de la fiche Google Business : zone d'intervention, photos et lien vers le site, pour apparaître dans les recherches locales.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 3 : RÉSULTAT ─── -->
  <section class="section fiche-section">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">03, Résultat</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Des demandes de devis dès la mise en ligne.</h2>
        <div class="fiche-text fade-in">
          <p>Dès le lancement du nouveau site, Blackwood Deck a reçu <strong>5 demandes de devis, dont 3 signées</strong>, puis des demandes qualifiées de façon régulière. Les clients mentionnent spontanément la qualité du site lors de la prise de contact.</p>
        </div>

        <div class="resultat-screens fade-in" style="margin-top: 32px;">
          <img src="/blackwood-1.webp" alt="Site web Blackwood Deck, terrasses en bois à Aix-en-Provence" style="width:100%; border-radius:var(--radius-md); object-fit:contain; background:var(--gray-50, #f9f9f9);" loading="lazy" />
        </div>

        <div class="metrics-row fade-in" style="margin-top:32px;">
          <div class="metric-card">
            <div class="metric-card-value" data-counter>5</div>
            <div class="metric-card-label">Devis reçus dès le lancement</div>
          </div>
          <div class="metric-card">
            <div class="metric-card-value" data-counter>3</div>
            <div class="metric-card-label">Projets signés</div>
          </div>
          <div class="metric-card">
            <div class="metric-card-value">20 ans</div>
            <div class="metric-card-label">Savoir-faire mis en valeur</div>
          </div>
          <div class="metric-card">
            <div class="metric-card-value">0 €</div>
            <div class="metric-card-label">Hébergement mensuel</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 4 : TÉMOIGNAGE ─── -->
  <section class="section fiche-section" style="background: var(--gray-50);">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">04, Témoignage</span>
      </div>
      <div class="fiche-section-content">
        <div class="temoignage-block fade-in">
          <div class="temoignage-quote-mark" aria-hidden="true">"</div>
          <blockquote class="temoignage-texte">
            Merci pour le site, il marche très bien : j'ai des demandes de devis qualifiées régulières et les clients me disent tout de suite que le site est très bien foutu !
          </blockquote>
          <div class="temoignage-auteur">
            <div class="temoignage-avatar" style="background: #2B2219;" aria-hidden="true">
              <span>BD</span>
            </div>
            <div>
              <div class="temoignage-nom">Nicolas</div>
              <div class="temoignage-role">Blackwood Deck · Terrasses bois, Aix-en-Provence</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── SECTION 5 : CTA PROJET SIMILAIRE ─── -->
  <section class="section fiche-section">
    <div class="container fiche-container">
      <div class="fiche-section-label">
        <span class="section-label">05, Et vous ?</span>
      </div>
      <div class="fiche-section-content">
        <h2 class="section-title fade-in">Un site qui ne vous ressemble plus ?</h2>
        <div class="fiche-text fade-in">
          <p>Vous avez un site fait maison qui ne reflète pas la qualité de votre travail et ne génère pas de demandes ? La refonte clé en main d'aurore remet votre image en ligne à la hauteur de votre savoir-faire.</p>
          <p>Basée à Aix-en-Provence, j'interviens dans toute la France. Un formulaire de 2 minutes suffit pour recevoir un devis détaillé sous 48h.</p>
        </div>
        <div class="fiche-cta-buttons fade-in">
          <a href="/contact/" class="btn btn-aurora btn-lg">Démarrer mon projet →</a>
          <a href="/tarifs/" class="btn btn-outline btn-lg">Voir les tarifs</a>
          <a href="/realisations/" class="btn btn-ghost btn-lg">Voir toutes les réalisations</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── NAVIGATION ENTRE FICHES ─── -->
  <nav class="fiche-nav" aria-label="Navigation entre les réalisations">
    <div class="container">
      <div class="fiche-nav-inner">
        <a href="/realisations/le-mazarin-conciergerie-aix/" class="fiche-nav-prev-link">
          <span class="fiche-nav-label">Réalisation précédente</span>
          <span class="fiche-nav-titre">← Le Mazarin, Conciergerie</span>
        </a>
        <a href="/realisations/cv-bebe-en-provence-location/" class="fiche-nav-prev-link fiche-nav-next">
          <span class="fiche-nav-label">Réalisation suivante</span>
          <span class="fiche-nav-titre">C&amp;V Bébé en Provence →</span>
        </a>
      </div>
    </div>
  </nav>

</BaseLayout>

<style>
  /* ─── HERO FICHE ─── */
  .fiche-hero {
    padding: 32px 0 80px;
  }

  .fiche-hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .fiche-h1 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1.05;
    color: var(--black);
    margin-bottom: 16px;
  }

  .fiche-sub {
    font-size: clamp(15px, 1.2vw, 17px);
    color: var(--gray-500);
    line-height: 1.65;
    margin-bottom: 32px;
  }

  /* Couverture fond uni */
  .fiche-cover {
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 32px;
    text-align: center;
    border: 1.5px solid rgba(0,0,0,0.06);
  }

  .fiche-cover-name {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.05;
  }

  .fiche-cover-sub {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* Tableau client */
  .client-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .client-table tr {
    border-bottom: 1px solid var(--gray-100);
  }

  .client-table tr:last-child {
    border-bottom: none;
  }

  .client-table th {
    text-align: left;
    font-weight: 600;
    color: var(--black);
    padding: 10px 16px 10px 0;
    width: 130px;
    vertical-align: top;
  }

  .client-table td {
    color: var(--gray-500);
    padding: 10px 0;
    vertical-align: top;
  }

  .table-link {
    color: var(--aurora);
    font-weight: 500;
    transition: var(--transition);
  }

  .table-link:hover {
    color: var(--aurora-dark);
  }

  /* ─── LAYOUT SECTIONS ─── */
  .fiche-section { padding: 80px 0; }

  .fiche-container {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 64px;
    align-items: start;
  }

  .fiche-section-label { padding-top: 6px; }

  .fiche-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .fiche-text p {
    font-size: 16px;
    color: var(--gray-500);
    line-height: 1.75;
    margin: 0;
  }

  /* ─── SOLUTION GRID ─── */
  .solution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .solution-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .solution-icon {
    width: 40px;
    height: 40px;
    background: var(--aurora-pale);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--aurora);
    flex-shrink: 0;
  }

  .solution-item h3 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }

  .solution-item p {
    font-size: 14px;
    color: var(--gray-500);
    line-height: 1.6;
    margin: 0;
  }

  /* ─── RÉSULTAT ─── */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .metric-card {
    background: var(--white);
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-md);
    padding: 20px 16px;
    text-align: center;
  }

  .metric-card-value {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--black);
    line-height: 1;
    margin-bottom: 6px;
  }

  .metric-card-label {
    font-size: 12px;
    color: var(--gray-500);
    line-height: 1.4;
  }

  /* ─── TÉMOIGNAGE ─── */
  .temoignage-block {
    background: var(--aurora-pale);
    border: 1.5px solid rgba(255,107,26,0.15);
    border-radius: var(--radius-xl);
    padding: 48px;
    position: relative;
  }

  .temoignage-quote-mark {
    font-family: var(--font-serif);
    font-size: 96px;
    line-height: 0.8;
    color: var(--aurora-light);
    margin-bottom: 16px;
    font-style: italic;
  }

  .temoignage-texte {
    font-size: clamp(17px, 1.5vw, 20px);
    font-style: italic;
    color: var(--gray-700);
    line-height: 1.7;
    margin-bottom: 32px;
    font-family: var(--font-serif);
    border: none;
    padding: 0;
  }

  .temoignage-auteur {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .temoignage-avatar {
    width: 44px;
    height: 44px;
    background: var(--aurora-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--white);
    flex-shrink: 0;
  }

  .temoignage-nom {
    font-size: 15px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.01em;
  }

  .temoignage-role {
    font-size: 13px;
    color: var(--gray-500);
    margin-top: 2px;
  }

  /* ─── CTA BOUTONS FICHE ─── */
  .fiche-cta-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }

  /* ─── NAVIGATION FICHES ─── */
  .fiche-nav {
    border-top: 1px solid var(--gray-100);
    padding: 32px 0;
  }

  .fiche-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }

  .fiche-nav-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gray-500);
    margin-bottom: 4px;
  }

  .fiche-nav-next {
    text-align: right;
  }

  .fiche-nav-prev-link {
    display: block;
  }

  .fiche-nav-titre {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--black);
    letter-spacing: -0.02em;
    transition: var(--transition);
  }

  .fiche-nav-prev-link:hover .fiche-nav-titre {
    color: var(--aurora);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    .fiche-hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .fiche-container {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .fiche-section-label { padding-top: 0; }
  }

  @media (max-width: 768px) {
    .fiche-hero { padding: 16px 0 56px; }

    .solution-grid { grid-template-columns: 1fr; }

    .metrics-row { grid-template-columns: 1fr 1fr; }

    .temoignage-block { padding: 28px 24px; }

    .fiche-cta-buttons { flex-direction: column; }

    .fiche-cta-buttons .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
